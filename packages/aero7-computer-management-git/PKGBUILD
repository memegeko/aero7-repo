pkgname=aero7-computer-management-git
pkgver=0.2.0.r20.g6d7fe79
pkgrel=1
pkgdesc='Aero7-native Computer Management console for Linux'
arch=('x86_64')
url='https://github.com/aero7-open-project/aero7-computer-management'
license=('MIT')
depends=('qt6-base' 'systemd' 'udisks2' 'polkit' 'shadow' 'dosfstools' 'e2fsprogs')
makedepends=('cmake' 'ninja' 'git')
optdepends=('samba: Shared Folders status'
            'aero7-device-manager: Device Manager integration'
            'ntfs-3g: create and resize NTFS volumes'
            'exfatprogs: create exFAT volumes'
            'btrfs-progs: create and resize Btrfs volumes'
            'xfsprogs: create and resize XFS volumes')
provides=('aero7-computer-management')
conflicts=('aero7-computer-management')
options=('!debug')
source=("aero7-computer-management::git+$url.git#commit=6d7fe79c579f35c5d1471cea57691e4ee28c237a")
sha256sums=('SKIP')

build() {
  cmake -S aero7-computer-management -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 aero7-computer-management/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
