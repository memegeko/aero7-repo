prepare() {
  patch -d aero-kolourpaint -Np1 < aero7.patch
  patch -d aero-kolourpaint -Np1 < aero7-ribbon-startup-layout.patch
  patch -d aero-kolourpaint -Np1 < aero7-common-dialog.patch
  patch -d aero-kolourpaint -Np1 < aero7-document-workflow.patch
  # The pinned SARibbon translation unit uses CRLF; normalize its line endings
  # before applying the focused lifetime patch.
  sed -i 's/\r$//' saribbon/src/SARibbonBar/SARibbonToolButton.cpp
  patch -d saribbon -Np1 < aero7-ribbon-style-lifetime.patch
  patch -d saribbon -Np1 < aero7-ribbon-icon-cache.patch
}

build() {
  cmake -S saribbon -B saribbon-build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$srcdir/saribbon-prefix" \
    -DSARIBBON_BUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF
  cmake --build saribbon-build
  cmake --install saribbon-build

  cmake -S aero-kolourpaint -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_PREFIX_PATH="$srcdir/saribbon-prefix" -DCMAKE_SKIP_RPATH=ON \
    -DBUILD_TESTING=OFF
  cmake --build build
}

check() {
  c++ -std=c++17 -fPIC aero7-ribbon-close-test.cpp \
    -I"$srcdir/saribbon/src/SARibbonBar" -L"$srcdir/saribbon-build/lib" \
    -Wl,-rpath,"$srcdir/saribbon-build/lib" -lSARibbonBar \
    $(pkg-config --cflags --libs Qt6Widgets) -o aero7-ribbon-close-test
  QT_QPA_PLATFORM=offscreen ./aero7-ribbon-close-test
  c++ -std=c++17 -fPIC aero7-ribbon-colour-cache-test.cpp \
    -I"$srcdir/saribbon/src/SARibbonBar" -L"$srcdir/saribbon-build/lib" \
    -Wl,-rpath,"$srcdir/saribbon-build/lib" -lSARibbonBar \
    $(pkg-config --cflags --libs Qt6Widgets) -o aero7-ribbon-colour-cache-test
  QT_QPA_PLATFORM=offscreen ./aero7-ribbon-colour-cache-test
  bash "$srcdir/aero7-ribbon-layout-test.sh" \
    "$srcdir/build/bin/kolourpaint" "$srcdir/saribbon-build/lib"
  bash "$srcdir/aero7-common-dialog-test.sh" \
    "$srcdir/build/bin/kolourpaint" "$srcdir/saribbon-build/lib" \
    "${Aero7CommonDialogs_ROOT:-/usr}"
  bash "$srcdir/aero7-document-workflow-test.sh" \
    "$srcdir/build/bin/kolourpaint" "$srcdir/saribbon-build/lib" \
    "${Aero7CommonDialogs_ROOT:-/usr}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  DESTDIR="$pkgdir" cmake --install saribbon-build --prefix /usr
  # Brand the installed launcher itself, so menus and software inventory agree.
  # Keep the upstream desktop ID, executable, icon, MIME types and translations
  # of descriptive text; localized application names must not restore the old brand.
  local desktop="$pkgdir/usr/share/applications/org.kde.kolourpaint.desktop"
  sed -i -E 's/^(Name(\[[^]]+\])?)=.*/\1=Paint/' "$desktop"
  grep -qx 'Name=Paint' "$desktop" || return 1
  if grep -E '^Name(\[[^]]+\])?=' "$desktop" | grep -v '=Paint$'; then
    printf 'Paint launcher still contains a different localized application name.\n' >&2
    return 1
  fi
  install -Dm644 aero-kolourpaint/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 aero-kolourpaint/COPYING.DOC "$pkgdir/usr/share/licenses/$pkgname/COPYING.DOC"
  install -Dm644 aero-kolourpaint/COPYING.LIB "$pkgdir/usr/share/licenses/$pkgname/COPYING.LIB"
  install -Dm644 saribbon/LICENSE "$pkgdir/usr/share/licenses/$pkgname/SARibbon-LICENSE"
}
