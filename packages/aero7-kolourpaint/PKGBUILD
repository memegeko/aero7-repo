depends=('glibc' 'kconfig' 'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kguiaddons'
         'ki18n' 'kio' 'kwidgetsaddons' 'kxmlgui' 'libstdc++' 'qt6-base'
         'qt6-svg' 'aero7-file-explorer>=25.12.3-36')
