# Maintainer: Aero7 Open Project
pkgname=aero7-device-manager
pkgver=2.2.1.r1.g6d080f8
pkgrel=1
_commit=6d080f81a72405a7b0bb0c0a4c0417e219b3d9e2
pkgdesc="Aero7 Device Manager with real Linux hardware backends"
arch=('x86_64' 'aarch64')
url="https://github.com/aero7-open-project/aero7-device-manager"
license=('GPL-3.0-only')
depends=('qt6-base')
makedepends=('cmake' 'git' 'ninja')
provides=('linux-devmgmt')
conflicts=('linux-devmgmt')
replaces=('linux-devmgmt')
options=('!debug')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
