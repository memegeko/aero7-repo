pkgname=aero7-gadgets
pkgver=3.0.0
pkgrel=28
pkgdesc='Native Windows 7-style desktop gadget runtime, gallery and nine built-in gadgets for Aero7'
arch=('x86_64')
url='https://gitgud.io/aero7-open-project/aero7-desktop'
license=('MIT')
depends=('kwindowsystem' 'layer-shell-qt' 'qt6-base' 'qt6-svg')
makedepends=('cmake' 'dbus' 'git' 'kservice' 'ninja')
provides=('win-gadgets')
conflicts=('win-gadgets' 'win-gadgets-git')
install="$pkgname.install"
_commit=9329ad98919ad0825bff4476c06aca9cebc1448a
source=("aero7-desktop::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/aero7-desktop/companions/aero7-gadgets" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/aero7-desktop/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
