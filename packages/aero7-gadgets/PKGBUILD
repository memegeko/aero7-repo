pkgname=aero7-gadgets
pkgver=3.0.0
pkgrel=3
pkgdesc='Native Windows 7-style desktop gadget runtime, gallery and nine built-in gadgets for Aero7'
arch=('x86_64')
url='https://github.com/aero7-open-project/aero7-desktop'
license=('MIT')
depends=('kwindowsystem' 'layer-shell-qt' 'qt6-base' 'qt6-svg')
makedepends=('cmake')
provides=('win-gadgets')
conflicts=('win-gadgets' 'win-gadgets-git')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('5e21432024e11a89066f9234b8e79f1cad37deecd2fec0db7f627aa8b3f93719')

build() {
  cmake -S "$srcdir/$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
