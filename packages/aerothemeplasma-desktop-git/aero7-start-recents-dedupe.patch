+                }
+                if (!launcher) {
+                    return false;
+                }
+                const favorites = Array.from(globalFavorites.favorites || []);
+                for (let index = 0; index < favorites.length; ++index) {
+                    if (canonicalLauncher(favorites[index]) === launcher) {
+                        return true;
+                    }
+                }
+                return false;
+            }
