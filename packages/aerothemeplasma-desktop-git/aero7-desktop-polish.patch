+            } catch (error) {
+                console.warn("SevenStart could not read Aero7 settings:", error);
+                settingsCatalog = [];
+            }
+            rebuildSettingsResults();
+        }
+        Component.onCompleted: connectSource("/usr/bin/control --list-settings-json")
+    }
+
+    Plasma5Support.DataSource {
