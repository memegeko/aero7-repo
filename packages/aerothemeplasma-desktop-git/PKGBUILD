# Maintainer: WackyIdeas <wackyideas@disroot.org>

pkgname=('aerothemeplasma-desktop-git')
pkgver=6.7.0_731.r6746c83
pkgrel=4
pkgdesc="An alternative shell for KDE Plasma that aims to replicate the look and feel of Windows 7"
arch=(x86_64)
url="https://github.com/aeroshell-desktop/aerothemeplasma"
license=('AGPL-3.0-or-later')
depends=(gcc-libs
         bash
         glibc
         aeroshell-libplasma
         aeroshell-workspace
         aeroshell-kwin-components
         aerothemeplasma-sounds
         aerothemeplasma-icons
         aeroshell-smod
         qt6-virtualkeyboard
         qt6-multimedia
         qt6-5compat
         qt6-wayland
         qt6-declarative
         kconfigwidgets
         ksvg
         wayland
         kiconthemes
         plasma-activities
         kjobwidgets
         kio
         kglobalaccel
         kpipewire
         ki18n
         kwin
         plasma-workspace
         powerdevil
         kauth
         kcmutils
         networkmanager-qt
         kconfig
         kquickcharts
         prison
         knewstuff
         kdeclarative
         kirigami-addons
         kcoreaddons
         kservice
         kxmlgui
         plasma5support
         kvantum
         sddm
         sddm-kcm
         plasma-nm
         plasma-pa
         kwindowsystem
         knotifications
         knotifyconfig
         kmenuedit
         kirigami
         kitemmodels
         kpackage
         kwidgetsaddons
         plasma-desktop
         qt6-base)
optdepends=(uac-polkit-agent
            qrca)
makedepends=(git
             extra-cmake-modules
             plasma-wayland-protocols
             vulkan-headers)
options=('!debug')
source=("${pkgname}::git+${url}.git#commit=6746c83e05b718cda8b28a8e25921b0d73a950f0"
        'aero7-desktop-polish.patch'
        'aero7-start-orb.png'
        'aero7-start-orb-small.png'
        'aero7-watermark.png')
sha256sums=('SKIP'
            'e30a6726a0d394ad8b99cdfc461d15b356238a325cccdcbdc0f67477bff30435'
            '735055d95a98934fec5a020c1c1d7478a19765bcb2adc0f4895d20dba01cac7d'
            '1d15995bbb1f443509b9c31c3746b74b94b24677c4343a69a3cce55fe84d194a'
            'fb2f77fa6b3dd7bb0f1f096c4b0f5aba8b32344f8a6dbada1f094e8e5e283ef4')
conflicts=(aerothemeplasma-desktop)
provides=(aerothemeplasma-desktop)
groups=(aerothemeplasma)

pkgver() {
  cd "$srcdir/${pkgname%}"
  echo "$(grep 'set(PROJECT_VERSION ' CMakeLists.txt | cut -d '"' -f 2)_$(git rev-list --count HEAD).r$(git rev-parse --short HEAD)"
}

prepare() {
  patch -d "${pkgname%}" -Np1 < aero7-desktop-polish.patch
  install -Dm644 aero7-start-orb.png \
    "${pkgname%}/plasma/plasmoids/io.gitgud.wackyideas.SevenStart/contents/ui/orbs/orb.png"
  install -Dm644 aero7-start-orb-small.png \
    "${pkgname%}/plasma/plasmoids/io.gitgud.wackyideas.SevenStart/contents/ui/orbs/orb_small.png"
  install -Dm644 aero7-watermark.png \
    "${pkgname%}/plasma/look-and-feel/authui7/contents/images/aero7-watermark.png"
  rm -f "${pkgname%}/plasma/look-and-feel/authui7/contents/images/watermark.png"
}

build() {
  DESTDIR="$pkgdir" cmake -B build -S ${pkgname%} \
    -DBUILD_TESTING=OFF -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
