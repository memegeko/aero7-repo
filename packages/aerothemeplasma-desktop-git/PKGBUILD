pkgver=6.7.0_753.r49f3403
pkgrel=4
pkgdesc="An Aero-inspired classic desktop shell for KDE Plasma"
arch=(x86_64)
url="https://gitgud.io/aero7-open-project/aerothemeplasma"
license=('AGPL-3.0-or-later')
depends=(gcc-libs
         bash
         glibc
         aeroshell-libplasma
