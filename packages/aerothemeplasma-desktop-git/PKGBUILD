            qrca)
makedepends=(git
             extra-cmake-modules
             plasma-wayland-protocols
             vulkan-headers)
checkdepends=(python)
options=('!debug')
source=("${pkgname}::git+${url}.git#commit=49f340344edfe4871f1f2c42bd220c470103197e"
        'aero7-beta2-integration.patch'
        'Aero7OnScreenKeyboard.qml'
        'aero7-login-background.jpg'
        'aero7-sddm-runtime-test.py'
        'aero7-watermark.png'
        'aero7-kwalletrc'
        'aero7-kdeglobals')
sha256sums=('SKIP'
            '9397da5031d7c29043b6c4344f06979342ea90b7af2d67f2f2811ef3af194d22'
            'e56d78b54366bee688a4eece2a0a4bdf6f8a0f490d3319a4285f4734ade8a7bd'
            '65e825c2dcc1b0c80d14896a6108199d825f8dc7b44724f22fe19d8b308fb7e7'
            'bf7e44188d7a682d7aa0eddf865ced1569c0f518a8c04d47445d04e8571d0d9d'
            'd45164d6d67f2d8ccae63c4fd83bd0dd73e05808f3c8cd739c4850b5680d4982'
            '10512740e425d40a16d6d3dee52e5b87301b60446649a56c98237be9aeb6bdf7'
            'c51bea0944c694259c9a9d2b5429f98310075b592a1581e51a5138cd5e00c837')
conflicts=(aerothemeplasma-desktop)
provides=(aerothemeplasma-desktop)
groups=(aerothemeplasma)
backup=('etc/xdg/kwalletrc')

pkgver() {
  cd "$srcdir/${pkgname%}"
  # The testing mirror has a shorter history than the previous package source.
  # Keep package versions increasing from the last published 752 revision.
  local revision=$((752 + $(git rev-list --count fd68c11730ca1dce173a229d441c5e9ed0aebcb8..HEAD)))
  echo "$(grep 'set(PROJECT_VERSION ' CMakeLists.txt | cut -d '"' -f 2)_${revision}.r$(git rev-parse --short HEAD)"
}

prepare() {
  patch -d "${pkgname%}" -Np1 < aero7-beta2-integration.patch
}

build() {
  DESTDIR="$pkgdir" cmake -B build -S ${pkgname%} \
    -DBUILD_TESTING=ON -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
  python "$srcdir/aero7-sddm-runtime-test.py" \
    "$srcdir/${pkgname%}/plasma/sddm/sddm-theme-mod"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "${pkgname%}/LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "${pkgname%}/THIRD_PARTY.md" \
      "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/Assets/aero7-branding-r3.png"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/plasma/shells/io.gitgud.wackyideas.desktop/contents/images/branding.png"
    # Own the accepted Welcome background so upgrades cannot restore the
    # upstream preview or the previously clipped Aero7 logo treatment.
    local background_name
    for background_name in background default-background preview.png; do
      install -Dm644 "$srcdir/aero7-login-background.jpg" \
        "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/$background_name"
    done
    # Keep logout and splash branding independent of upstream Windows assets.
    local authui="$pkgdir/usr/share/plasma/look-and-feel/authui7"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$authui/contents/images/aero7-package-branding.png"
    sed -i 's|../images/watermark.png|../images/aero7-package-branding.png|g' \
      "$authui/contents/splash/Splash.qml" "$authui/contents/logout/Logout.qml"
    sed -i 's/Windows 7/Aero7/g' "$authui/metadata.json"
    rm -f -- "$authui/contents/images/watermark.png" \
      "$authui/contents/previews/preview.png" \
      "$authui/contents/previews/fullscreenpreview.jpg"
    cmp "$srcdir/aero7-watermark.png" \
      "$authui/contents/images/aero7-package-branding.png"
    grep -Fq '../images/aero7-package-branding.png' \
      "$authui/contents/splash/Splash.qml"
    grep -Fq '../images/aero7-package-branding.png' \
      "$authui/contents/logout/Logout.qml"
    install -Dm644 "$srcdir/Aero7OnScreenKeyboard.qml" \
      "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/SMOD/Aero7OnScreenKeyboard.qml"
    install -Dm644 "$srcdir/aero7-kwalletrc" \
      "$pkgdir/etc/xdg/kwalletrc"
    install -Dm644 "$srcdir/aero7-kdeglobals" \
      "$pkgdir/etc/xdg/kdeglobals"
}
