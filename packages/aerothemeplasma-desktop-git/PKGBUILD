pkgver() {
  cd "$srcdir/${pkgname%}"
  echo "$(grep 'set(PROJECT_VERSION ' CMakeLists.txt | cut -d '"' -f 2)_$(git rev-list --count HEAD).r$(git rev-parse --short HEAD)"
}

prepare() {
  patch -d "${pkgname%}" -Np1 < aero7-desktop-polish.patch
  patch -d "${pkgname%}" -Np1 < aero7-search-sections.patch
  patch -d "${pkgname%}" -Np1 < aero7-sevenstart-plasma67-stability.patch
  patch -d "${pkgname%}" -Np1 < aero7-start-links.patch
  patch -d "${pkgname%}" -Np1 < aero7-hide-system-settings.patch
  patch -d "${pkgname%}" -Np1 < aero7-control-panel-links-and-audio-empty-state.patch
  patch -d "${pkgname%}" -Np1 < aero7-desktop-context-and-gadgets.patch
  patch -d "${pkgname%}" -Np1 < aero7-runtime-qml-stability.patch
  patch -d "${pkgname%}" -Np1 < aero7-start-no-empty-dialog.patch
  patch -d "${pkgname%}" -Np1 < aero7-shell-context-and-snipping.patch
  patch -d "${pkgname%}" -Np1 < aero7-start-context-import-fix.patch
  patch -d "${pkgname%}" -Np1 < aero7-remove-edit-mode.patch
  patch -d "${pkgname%}" -Np1 < aero7-win7-comparison-pass.patch
  patch -d "${pkgname%}" -Np1 < aero7-start-recents-dedupe.patch
  patch -d "${pkgname%}" -Np1 < aero7-ie-taskbar-identity.patch
  patch -d "${pkgname%}" -Np1 < aero7-fresh-install-login-lock.patch
  cp -a "$srcdir/aero7-no-visible-kde-overlay/." "${pkgname%}/"
}

build() {
  DESTDIR="$pkgdir" cmake -B build -S ${pkgname%} \
    -DBUILD_TESTING=ON -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "${pkgname%}/LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "${pkgname%}/THIRD_PARTY.md" \
      "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/Assets/aero7-branding-r3.png"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/plasma/shells/io.gitgud.wackyideas.desktop/contents/images/branding.png"
    install -Dm644 "$srcdir/Aero7OnScreenKeyboard.qml" \
      "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/SMOD/Aero7OnScreenKeyboard.qml"
    install -Dm644 "$srcdir/aero7-kwalletrc" \
      "$pkgdir/etc/xdg/kwalletrc"
    install -Dm644 "$srcdir/aero7-kdeglobals" \
      "$pkgdir/etc/xdg/kdeglobals"
}
