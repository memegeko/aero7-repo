# Maintainer: WackyIdeas <wackyideas@disroot.org>

pkgname=('aerothemeplasma-desktop-git')
pkgver=6.7.0_731.r6746c83
pkgrel=3
pkgdesc="An alternative shell for KDE Plasma that aims to replicate the look and feel of Windows 7"
arch=(x86_64)
url="https://github.com/aeroshell-desktop/aerothemeplasma"
license=('AGPL-3.0-or-later')
depends=(gcc-libs
         bash
         glibc
         aeroshell-libplasma
         aeroshell-workspace
         aeroshell-kwin-components
         aerothemeplasma-sounds
         aerothemeplasma-icons
         aeroshell-smod
         qt6-virtualkeyboard
         qt6-multimedia
         qt6-5compat
         qt6-wayland
         qt6-declarative
         kconfigwidgets
         ksvg
         wayland
         kiconthemes
         plasma-activities
         kjobwidgets
         kio
         kglobalaccel
         kpipewire
         ki18n
         kwin
         plasma-workspace
         powerdevil
         kauth
         kcmutils
         networkmanager-qt
         kconfig
         kquickcharts
         prison
         knewstuff
         kdeclarative
         kirigami-addons
         kcoreaddons
         kservice
         kxmlgui
         plasma5support
         kvantum
         sddm
         sddm-kcm
         plasma-nm
         plasma-pa
         kwindowsystem
         knotifications
         knotifyconfig
         kmenuedit
         kirigami
         kitemmodels
         kpackage
         kwidgetsaddons
         plasma-desktop
         qt6-base)
optdepends=(uac-polkit-agent
            qrca)
makedepends=(git
             extra-cmake-modules
             plasma-wayland-protocols
             vulkan-headers)
options=('!debug')
source=("${pkgname}::git+${url}.git#commit=6746c83e05b718cda8b28a8e25921b0d73a950f0"
        'aero7-desktop-polish.patch'
        'aero7-start-orb.png'
        'aero7-start-orb-small.png')
sha256sums=('SKIP'
            'a85107dc2f49048bf441278b5b31fab902891f035439b0b7434e015c84a358e7'
            '3b4a582327becaae1c19da361e4aee4bd1533031e1afe6b14600524f8ad5fe80'
            '3b4a582327becaae1c19da361e4aee4bd1533031e1afe6b14600524f8ad5fe80')
conflicts=(aerothemeplasma-desktop)
provides=(aerothemeplasma-desktop)
groups=(aerothemeplasma)

pkgver() {
  cd "$srcdir/${pkgname%}"
  echo "$(grep 'set(PROJECT_VERSION ' CMakeLists.txt | cut -d '"' -f 2)_$(git rev-list --count HEAD).r$(git rev-parse --short HEAD)"
}

prepare() {
  patch -d "${pkgname%}" -Np1 < aero7-desktop-polish.patch
  install -Dm644 aero7-start-orb.png \
    "${pkgname%}/plasma/plasmoids/io.gitgud.wackyideas.SevenStart/contents/ui/orbs/orb.png"
  install -Dm644 aero7-start-orb-small.png \
    "${pkgname%}/plasma/plasmoids/io.gitgud.wackyideas.SevenStart/contents/ui/orbs/orb_small.png"
}

build() {
  DESTDIR="$pkgdir" cmake -B build -S ${pkgname%} \
    -DBUILD_TESTING=OFF -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
