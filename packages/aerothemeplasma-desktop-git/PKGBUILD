# Maintainer: WackyIdeas <wackyideas@disroot.org>

pkgname=('aerothemeplasma-desktop-git')
pkgver=6.7.0_742.r9c2d850
pkgrel=3
pkgdesc="An Aero-inspired classic desktop shell for KDE Plasma"
arch=(x86_64)
url="https://github.com/memegeko/aerothemeplasma"
license=('AGPL-3.0-or-later')
depends=(gcc-libs
         bash
         glibc
         aeroshell-libplasma
         aeroshell-workspace
         aeroshell-kwin-components
         aerothemeplasma-sounds
         aerothemeplasma-icons
         aeroshell-smod
         qt6-virtualkeyboard
         qt6-multimedia
         qt6-5compat
         qt6-wayland
         qt6-declarative
         kconfigwidgets
         ksvg
         wayland
         kiconthemes
         plasma-activities
         kjobwidgets
         kio
         kglobalaccel
         kpipewire
         ki18n
         kwin
         plasma-workspace
         powerdevil
         kauth
         kcmutils
         networkmanager-qt
         kconfig
         kquickcharts
         prison
         knewstuff
         kdeclarative
         kirigami-addons
         kcoreaddons
         kservice
         kxmlgui
         plasma5support
         kvantum
         sddm
         sddm-kcm
         plasma-nm
         plasma-pa
         kwindowsystem
         knotifications
         knotifyconfig
         kmenuedit
         kirigami
         kitemmodels
         kpackage
         kwidgetsaddons
         plasma-desktop
         qterminal
         vlc
         spectacle
         kcalc
         featherpad
         qt6-base)
optdepends=(uac-polkit-agent
            qrca)
makedepends=(git
             extra-cmake-modules
             plasma-wayland-protocols
             vulkan-headers)
options=('!debug')
source=("${pkgname}::git+${url}.git#commit=9c2d850f0907cd7d33c81e8a3fcc00abae3abb9b"
        'aero7-desktop-polish.patch'
        'aero7-search-sections.patch'
        'aero7-watermark.png')
sha256sums=('SKIP'
            'a5401b0b49372afc08658be7681d00d4ba15d13ad180fd00b27aff71d0cb2435'
            '534f81ad4a9ed2b521ce9ec66c41c8f538eda1e052b986507e0c025c946333c0'
            'fb2f77fa6b3dd7bb0f1f096c4b0f5aba8b32344f8a6dbada1f094e8e5e283ef4')
conflicts=(aerothemeplasma-desktop)
provides=(aerothemeplasma-desktop)
groups=(aerothemeplasma)

pkgver() {
  cd "$srcdir/${pkgname%}"
  echo "$(grep 'set(PROJECT_VERSION ' CMakeLists.txt | cut -d '"' -f 2)_$(git rev-list --count HEAD).r$(git rev-parse --short HEAD)"
}

prepare() {
  patch -d "${pkgname%}" -Np1 < aero7-desktop-polish.patch
  patch -d "${pkgname%}" -Np1 < aero7-search-sections.patch
}

build() {
  DESTDIR="$pkgdir" cmake -B build -S ${pkgname%} \
    -DBUILD_TESTING=OFF -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "${pkgname%}/LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "${pkgname%}/THIRD_PARTY.md" \
      "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/Assets/aero7-branding-r3.png"
}
