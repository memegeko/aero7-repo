         aero7-gadgets
         aero7-computer-management
         aero7-file-explorer
         linux-control-panel
         tuxmanager)
optdepends=(uac-polkit-agent
            qrca)
makedepends=(git
             extra-cmake-modules
             plasma-wayland-protocols
             vulkan-headers)
options=('!debug')
source=("${pkgname}::git+${url}.git#commit=8c7d82027dc82096eea769beab51cfd0e6390d91"
        'aero7-watermark.png'
        'aero7-kwalletrc'
        'aero7-kdeglobals')
sha256sums=('SKIP'
            'd45164d6d67f2d8ccae63c4fd83bd0dd73e05808f3c8cd739c4850b5680d4982'
            '10512740e425d40a16d6d3dee52e5b87301b60446649a56c98237be9aeb6bdf7'
            'c51bea0944c694259c9a9d2b5429f98310075b592a1581e51a5138cd5e00c837')
conflicts=(aerothemeplasma-desktop)
provides=(aerothemeplasma-desktop)
groups=(aerothemeplasma)
backup=('etc/xdg/kwalletrc')

pkgver() {
  cd "$srcdir/${pkgname%}"
  echo "$(grep 'set(PROJECT_VERSION ' CMakeLists.txt | cut -d '"' -f 2)_$(git rev-list --count HEAD).r$(git rev-parse --short HEAD)"
}

build() {
  DESTDIR="$pkgdir" cmake -B build -S ${pkgname%} \
    -DBUILD_TESTING=ON -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "${pkgname%}/LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "${pkgname%}/THIRD_PARTY.md" \
      "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/sddm/themes/sddm-theme-mod/Assets/aero7-branding-r3.png"
    install -Dm644 "$srcdir/aero7-watermark.png" \
      "$pkgdir/usr/share/plasma/shells/io.gitgud.wackyideas.desktop/contents/images/branding.png"
    install -Dm644 "$srcdir/aero7-kwalletrc" \
      "$pkgdir/etc/xdg/kwalletrc"
    install -Dm644 "$srcdir/aero7-kdeglobals" \
      "$pkgdir/etc/xdg/kdeglobals"
}
