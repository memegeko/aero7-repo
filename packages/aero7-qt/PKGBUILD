pkgname=aero7-qt
pkgver=1.0.0
pkgrel=2
pkgdesc='Licensed Qt 6 glass compatibility helpers for Aero7 applications'
arch=('any')
url='https://github.com/memegeko/aero7-shell'
license=('MIT')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('adaead296e6d24d7dba90b124c618d724b6e6deb18720129a837c2c6740fdadf')

build() {
  cmake -S "$srcdir/$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
