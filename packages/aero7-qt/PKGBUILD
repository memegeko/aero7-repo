pkgname=aero7-qt
pkgver=1.0.0
pkgrel=1
pkgdesc='Licensed Qt 6 glass compatibility helpers for Aero7 applications'
arch=('any')
url='https://github.com/memegeko/aero7-shell'
license=('MIT')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('550fdab34c1fe435032d5254f12408dc8a434f246c34a93a43fd48d5663eeb51')

build() {
  cmake -S "$srcdir/$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
