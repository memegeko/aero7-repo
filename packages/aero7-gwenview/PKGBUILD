pkgname=aero7-gwenview
pkgver=25.12.2
pkgrel=1
pkgdesc='Aero7-styled KDE image viewer with original code-drawn controls'
arch=('x86_64')
url='https://gitgud.io/atmk/gwenview-aero'
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=('baloo' 'cfitsio' 'exiv2' 'glibc' 'kcolorscheme' 'kcompletion' 'kconfig'
         'kconfigwidgets' 'kcoreaddons' 'kcrash' 'kfilemetadata' 'kguiaddons'
         'ki18n' 'kiconthemes' 'kimageannotator' 'kio' 'kitemmodels' 'kitemviews'
         'kjobwidgets' 'kparts' 'kservice' 'kwidgetsaddons' 'kxmlgui' 'lcms2'
         'libjpeg-turbo' 'libkdcraw' 'libpng' 'libstdc++' 'libtiff' 'libx11'
         'plasma-activities' 'purpose' 'qt6-base' 'qt6-multimedia' 'qt6-svg'
         'solid' 'wayland')
makedepends=('aero7-qt' 'extra-cmake-modules' 'git' 'kdoctools' 'ninja'
             'plasma-wayland-protocols' 'qt6-wayland' 'wayland-protocols')
provides=("gwenview=$pkgver")
conflicts=('gwenview')
source=("aero-gwenview::git+$url.git#commit=33e15a58e3017ab9a4e01070cc1e3b0138b3892d"
        'aero7.patch')
sha256sums=('SKIP'
            '07e63524606fd867c7fbde8b6abbd2d9aeb5f0390b92ba8b5c1fd3fe054dcc67')

prepare() {
  patch -d aero-gwenview -Np1 < aero7.patch
  rm -rf aero-gwenview/app/aero_components/res
}

build() {
  cmake -S aero-gwenview -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 aero-gwenview/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 aero-gwenview/COPYING.DOC "$pkgdir/usr/share/licenses/$pkgname/COPYING.DOC"
}
