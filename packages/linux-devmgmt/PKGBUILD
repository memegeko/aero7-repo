# Maintainer: actuallyaridan <https://github.com/actuallyaridan>
pkgname=linux-devmgmt
pkgver=2.2.1
pkgrel=1
_commit=b1452862ccb5548390aecaf8771a70b20aa48f28
pkgdesc="Aero7 Device Manager with real Linux hardware backends"
arch=('x86_64' 'aarch64')
url="https://github.com/memegeko/linux-devmgmt"
license=('GPL-3.0-only')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
options=('!debug')
source=("$pkgname-$_commit.tar.gz::https://github.com/memegeko/linux-devmgmt/archive/$_commit.tar.gz")
sha256sums=('2a9687fde187199ad2af9b51bd22e817b23bbde42c1884f59dcac5f86f8def68')

build() {
    cmake -S "$pkgname-$_commit" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
