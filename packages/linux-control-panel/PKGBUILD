pkgname=linux-control-panel
pkgver=0.1.0
pkgrel=5
pkgdesc='Aero7 system settings hub for Linux and Plasma 6'
arch=('x86_64')
url='https://github.com/memegeko/aero7-control-panel-'
license=('GPL-3.0-or-later')
depends=('cups' 'glibc' 'kwidgetsaddons' 'kwindowsystem' 'openssl' 'qt6-base'
         'qt6-multimedia' 'zlib' 'plasma-desktop' 'plasma-nm' 'polkit' 'ufw'
         'hunspell' 'hunspell-en_us' 'hunspell-nl' 'accountsservice'
         'networkmanager' 'pipewire-pulse' 'wireplumber' 'upower'
         'power-profiles-daemon' 'shadow')
makedepends=('aero7-qt' 'cmake' 'git' 'ninja')
source=("linux-control::git+$url.git#commit=61325411de9c9705183b5160606df4696a832061")
sha256sums=('SKIP')

build() {
  cmake -S linux-control -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 linux-control/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
