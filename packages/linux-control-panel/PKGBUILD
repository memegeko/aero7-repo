pkgname=linux-control-panel
pkgver=0.1.0
pkgrel=38
pkgdesc='Aero7 system settings hub for Linux and Plasma 6'
arch=('x86_64')
url='https://github.com/aero7-open-project/aero7-control-panel-'
license=('GPL-3.0-or-later')
depends=('cups' 'glibc' 'kwidgetsaddons' 'kwindowsystem' 'openssl' 'qt6-base'
         'qt6-multimedia' 'zlib' 'python' 'plasma-desktop' 'plasma-nm' 'polkit' 'iptables' 'ufw'
         'hunspell' 'hunspell-en_us' 'hunspell-nl' 'accountsservice'
         'networkmanager' 'pipewire-pulse' 'wireplumber' 'upower'
         'power-profiles-daemon' 'shadow' 'layer-shell-qt')
optdepends=('bluez-utils: Bluetooth discovery, pairing and connection management'
            'malcontent: Parental Controls optional feature'
            'deja-dup: Backup and Restore optional feature'
            'snapper: System Recovery snapshot backend on Btrfs'
            'btrfs-assistant: System Recovery interface on Btrfs'
            'orca: Advanced Accessibility screen reader'
            'speech-dispatcher: Advanced Accessibility speech service'
            'espeak-ng: Advanced Accessibility speech synthesis'
            'syncthing: Sync Center optional feature'
            'clamav: Aero7 Defender optional feature'
            'freerdp: Remote Desktop Connections optional feature'
            'samba: File and Printer Sharing optional feature'
            'modemmanager: Mobile Broadband and Modem optional feature'
            'colord: Color Management optional feature'
            'aero7-programs-center-git: Programs Center Beta optional feature')
makedepends=('aero7-qt' 'cmake' 'ninja')
source=('linux-control-panel-0.1.0-r38.tar.gz')
sha256sums=('870f4852b99e7125167ff4068def02a25302e5ca1958b49d65dfe0e96c23c546')

build() {
  cmake -S linux-control -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 linux-control/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
