# Maintainer: WackyIdeas <wackyideas@disroot.org>

pkgname=('aerothemeplasma-icons-git')
pkgver=11.r96950b8
pkgrel=3
pkgdesc="Icon theme designed for AeroThemePlasma"
license=('AGPL-3.0-or-later')
arch=(any)
url="https://gitgud.io/aeroshell/atp/aerothemeplasma-icons"
makedepends=('git')
options=('!strip' '!debug')
source=("${pkgname}::git+${url}.git#commit=96950b8028a5d960cb683280fe5f1d9e33e6b8a2"
        'aero7-icon-theme-metadata.patch')
sha256sums=('SKIP'
            'f89f5a47901b5593fdfe271a064c2d3ebd300b5941517c57022f8608a5bd22b8')
conflicts=(aerothemeplasma-icons)
provides=(aerothemeplasma-icons)
groups=(aerothemeplasma)

pkgver() {
  cd "$srcdir/${pkgname%}"
  echo "$(git rev-list --count HEAD).r$(git rev-parse --short HEAD)"
}

prepare() {
  patch -d "${pkgname%}" -Np1 < aero7-icon-theme-metadata.patch
}

package() {
  install -dm 755 "$pkgdir"/usr/share/icons/
  find "$srcdir/${pkgname%}" -mindepth 1 -maxdepth 1 -type d \
    ! -name '.*' \
    -exec cp -r -- {} "$pkgdir/usr/share/icons/" \;
  if find "$pkgdir" -type d \( -name .git -o -name .svn -o -name .hg -o -name .bzr \) \
      -print -quit | grep -q .; then
    error 'VCS metadata was copied into the icon package'
    return 1
  fi
  install -Dm644 "$srcdir/${pkgname%}/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/${pkgname%}/README.md" \
    "$pkgdir/usr/share/licenses/$pkgname/README.md"
}
