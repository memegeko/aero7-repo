pkgname=execbin
pkgver=0.23.0
pkgrel=6
pkgdesc='Aero7 Run dialog for Plasma 6 with original branding'
arch=('x86_64')
url='https://gitgud.io/catpswin56/execbin'
license=('AGPL-3.0-or-later')
depends=('glibc' 'kwindowsystem' 'qt6-base')
makedepends=('cmake' 'extra-cmake-modules' 'git' 'ninja')
source=("execbin::git+$url.git#commit=6127849ad534b07d44b278b14f2246cf43ada3b9"
        'aero7.patch'
        'aero7-companion.png'
        'org.aero7.execbin.desktop')
sha256sums=('SKIP'
            '599786a7ea330e55a7b0dfca043b984f6ef60d37c49e3cc1bb33ee7a28180fe0'
            'd0803ba0db071263d15e673dcb2b17d9d2864e2cb9162161a82b44ed798b01af'
            'f187f8221890c95b3f7e9cc0088b307951fca67f4df8e73d6ab8d63990c4a2ca')

prepare() {
  patch -d execbin -Np1 < aero7.patch
  install -Dm644 aero7-companion.png execbin/resources/aero7-companion.png
  rm -f execbin/resources/app.ico execbin/resources/32.png
}

build() {
  cmake -S execbin -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 org.aero7.execbin.desktop "$pkgdir/usr/share/applications/org.aero7.execbin.desktop"
  install -Dm644 aero7-companion.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/org.aero7.execbin.png"
  install -Dm644 execbin/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
