diff --git a/tests/test_offline_backend.cpp b/tests/test_offline_backend.cpp
new file mode 100644
index 0000000..92b1e21
--- /dev/null
+++ b/tests/test_offline_backend.cpp
@@ -0,0 +1,94 @@
+#include "backend/AlpmBackend.h"
+#include "metadata/Metadata.h"
+#include <QDir>
+#include <QFile>
+#include <QProcess>
+#include <QTemporaryDir>
+#include <QtTest>
+
+namespace {
+bool writeFile(const QString &path, const QByteArray &data) {
+    if(!QDir().mkpath(QFileInfo(path).absolutePath())) return false;
+    QFile file(path);
+    return file.open(QIODevice::WriteOnly) && file.write(data)==data.size();
+}
+const QByteArray description=
+    "%NAME%\nsample-app\n\n%VERSION%\n1.0-1\n\n%DESC%\nSample application\n\n"
+    "%ARCH%\nx86_64\n\n%SIZE%\n4096\n\n";
+bool initializeLocal(const QString &db) {
+    return writeFile(db+"/local/ALPM_DB_VERSION", "9\n")
+        && writeFile(db+"/local/sample-app-1.0-1/desc", description)
+        && writeFile(db+"/local/sample-app-1.0-1/files",
+                     "%FILES%\nusr/share/applications/org.aero7.Sample.desktop\n\n");
+}
+}
+
+class OfflineBackendTest:public QObject {
+    Q_OBJECT
+private slots:
+    void installedWithoutSyncDatabases() {
+        QTemporaryDir root;
+        QVERIFY(root.isValid());
+        const QString db=root.path()+"/var/lib/pacman";
+        QVERIFY(initializeLocal(db));
+        AlpmBackend backend(nullptr, root.path(), db, {"test-repo"});
+        const auto packages=backend.packages();
+        QCOMPARE(packages.size(),1);
+        const auto &package=packages.first();
+        QCOMPARE(package.name,QString("sample-app"));
+        QCOMPARE(package.state,PackageState::Installed);
+        QCOMPARE(package.installedVersion,QString("1.0-1"));
+        QCOMPARE(package.repository,QString("local"));
+        QCOMPARE(package.downloadSize,0);
+        QCOMPARE(package.desktopIds,QStringList{"org.aero7.Sample"});
+        QVERIFY(backend.lastError().isEmpty());
+        QVERIFY(backend.repositoryWarning().contains("test-repo"));
+        QVERIFY(backend.updates().isEmpty());
+        QVERIFY(!backend.repositoryWarning().isEmpty());
+        QCOMPARE(backend.packages().size(),1); // Repeated refresh must retain local data.
+    }
+
+    void syncAndLocalDoNotDuplicateInstalledPackage() {
+        QTemporaryDir root;
+        const QString db=root.path()+"/var/lib/pacman";
+        QVERIFY(initializeLocal(db));
+        const QString staging=root.path()+"/repo";
+        QVERIFY(writeFile(staging+"/sample-app-1.0-1/desc",description+
+                          "%FILENAME%\nsample-app-1.0-1-x86_64.pkg.tar.zst\n\n"));
+        QVERIFY(QDir().mkpath(db+"/sync"));
+        QCOMPARE(QProcess::execute("bsdtar",{"-cf",db+"/sync/test-repo.db",
+                 "-C",staging,"sample-app-1.0-1"}),0);
+        AlpmBackend backend(nullptr,root.path(),db,{"test-repo"});
+        const auto packages=backend.packages();
+        QCOMPARE(packages.size(),1);
+        QCOMPARE(packages.first().repository,QString("test-repo"));
+        QCOMPARE(packages.first().state,PackageState::Installed);
+        QCOMPARE(packages.first().desktopIds,QStringList{"org.aero7.Sample"});
+        QVERIFY2(backend.repositoryWarning().isEmpty(),qPrintable(backend.repositoryWarning()));
+    }
+
+    void namespacedDesktopUsesPackageOwnership() {
+        QTemporaryDir root;
+        const QString desktop=root.filePath("org.aero7.Sample.desktop");
+        QVERIFY(writeFile(desktop,"[Desktop Entry]\nType=Application\nName=Sample App\n"
+                                  "Comment=An installed application\nIcon=sample\nCategories=Office;\n"));
+        Metadata metadata;
+        metadata.load({root.path()});
+        Package package;
+        package.name="sample-app";
+        package.desktopIds={"org.aero7.Sample"};
+        metadata.enrich(package);
+        QVERIFY(package.application);
+        QCOMPARE(package.displayName,QString("Sample App"));
+        QCOMPARE(package.category,QString("Office"));
+        QVERIFY(QFile::remove(desktop));
+        metadata.load({root.path()});
+        Package removed;
+        removed.name=package.name;
+        removed.desktopIds=package.desktopIds;
+        metadata.enrich(removed);
+        QVERIFY(!removed.application);
+    }
+};
+QTEST_GUILESS_MAIN(OfflineBackendTest)
+#include "test_offline_backend.moc"
diff --git a/src/ui/WrappingGridLayout.h b/src/ui/WrappingGridLayout.h
new file mode 100644
index 0000000..dfb8d1b
--- /dev/null
+++ b/src/ui/WrappingGridLayout.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <QLayout>
+#include <QList>
+
+// Equal-width columns that wrap to the available viewport, without retaining
+// the minimum width of a previously wider row after the window shrinks.
+class WrappingGridLayout final : public QLayout {
+public:
+    explicit WrappingGridLayout(QWidget *parent = nullptr) : QLayout(parent) {
+        setContentsMargins(0, 0, 0, 0);
+        setSpacing(8);
+    }
+    ~WrappingGridLayout() override {
+        while (auto *item = takeAt(0)) delete item;
+    }
+    void addItem(QLayoutItem *item) override { m_items.append(item); invalidate(); }
+    int count() const override { return m_items.size(); }
+    QLayoutItem *itemAt(int index) const override { return m_items.value(index); }
+    QLayoutItem *takeAt(int index) override {
+        if (index < 0 || index >= count()) return nullptr;
+        auto *item = m_items.takeAt(index);
+        invalidate();
+        return item;
+    }
+    Qt::Orientations expandingDirections() const override { return Qt::Horizontal; }
+    bool hasHeightForWidth() const override { return true; }
+    int heightForWidth(int width) const override { return arrange(QRect(0, 0, width, 0), false); }
+    QSize sizeHint() const override { return minimumSize(); }
+    QSize minimumSize() const override {
+        QSize size;
+        for (auto *item : m_items) size = size.expandedTo(item->minimumSize());
+        const auto margins = contentsMargins();
+        return size + QSize(margins.left() + margins.right(), margins.top() + margins.bottom());
+    }
+    void setGeometry(const QRect &rect) override {
+        QLayout::setGeometry(rect);
+        arrange(rect, true);
+    }
+private:
+    int arrange(const QRect &rect, bool apply) const {
+        const auto margins = contentsMargins();
+        const QRect area = rect.marginsRemoved(margins);
+        const int gap = qMax(0, spacing());
+        int minimumWidth = 1;
+        for (auto *item : m_items) minimumWidth = qMax(minimumWidth, item->minimumSize().width());
+        const int columns = qMax(1, qMin(count(), (area.width() + gap) / (minimumWidth + gap)));
+        const int width = qMax(1, (area.width() - gap * (columns - 1)) / columns);
+        int y = area.y();
+        for (int start = 0; start < count(); start += columns) {
+            int height = 0;
+            for (int i = start; i < qMin(start + columns, count()); ++i) {
+                auto *item = m_items.at(i);
+                height = qMax(height, qMax(item->minimumSize().height(),
+                    item->hasHeightForWidth() ? item->heightForWidth(width) : item->sizeHint().height()));
+            }
+            if (apply) for (int i = start; i < qMin(start + columns, count()); ++i)
+                m_items.at(i)->setGeometry(QRect(area.x() + (i - start) * (width + gap), y, width, height));
+            y += height + gap;
+        }
+        return margins.top() + margins.bottom() + (count() ? y - area.y() - gap : 0);
+    }
+    QList<QLayoutItem *> m_items;
+};
diff --git a/tests/test_home_layout.cpp b/tests/test_home_layout.cpp
new file mode 100644
index 0000000..c810cfd
--- /dev/null
+++ b/tests/test_home_layout.cpp
@@ -0,0 +1,82 @@
+#include "ui/MainWindow.h"
+#include "ui/ProgramCard.h"
+#include "ui/WrappingGridLayout.h"
+#include <QLabel>
+#include <QScrollArea>
+#include <QScrollBar>
+#include <QSettings>
+#include <QTemporaryDir>
+#include <QtTest>
+
+class HomeLayoutTest : public QObject {
+    Q_OBJECT
+    QTemporaryDir settings;
+    static void fill(QWidget *host) {
+        while (auto *item = host->layout()->takeAt(0)) { delete item->widget(); delete item; }
+        for (int i = 0; i < 8; ++i) {
+            Package package;
+            package.name = QString("test-%1").arg(i);
+            package.displayName = "Computer Management and File Utilities";
+            package.summary = "A longer description that must wrap without hiding the install button or overlapping another card.";
+            package.repository = "aero7";
+            host->layout()->addWidget(new ProgramCard(package));
+        }
+    }
+private slots:
+    void initTestCase() {
+        QVERIFY(settings.isValid());
+        QSettings::setDefaultFormat(QSettings::IniFormat);
+        QSettings::setPath(QSettings::IniFormat, QSettings::UserScope, settings.path());
+        QSettings::setPath(QSettings::NativeFormat, QSettings::UserScope, settings.path());
+    }
+    void homeRemainsInsideViewport() {
+        MainWindow window(parseDeepLink({"app", "--home"}));
+        auto *scroll = window.findChild<QScrollArea *>();
+        QVERIFY(scroll);
+        auto *host = scroll->findChild<QWidget *>("recommendedGrid");
+        QVERIFY(host);
+        fill(host);
+        window.show();
+        QVERIFY(QTest::qWaitForWindowExposed(&window));
+        for (int width : {1600, 1200, 900, 1200}) {
+            window.resize(width, 780);
+            // Wayland commits compositor-approved sizes asynchronously. Wait
+            // for the requested size, not a fixed delay that can test the old
+            // geometry or catch the scroll area's intermediate resize.
+            QTRY_COMPARE(window.size(), QSize(width, 780));
+            QTRY_COMPARE(scroll->widget()->width(), scroll->viewport()->width());
+            qInfo() << "Home geometry" << "requested" << width << "window" << window.size()
+                    << "content" << scroll->widget()->size() << "viewport" << scroll->viewport()->size()
+                    << "minimum" << scroll->widget()->minimumSizeHint();
+            QCOMPARE(scroll->horizontalScrollBar()->maximum(), 0);
+            QVERIFY(scroll->widget()->width() <= scroll->viewport()->width());
+            const auto cards = host->findChildren<ProgramCard *>(QString(), Qt::FindDirectChildrenOnly);
+            QCOMPARE(cards.size(), 8);
+            for (auto *card : cards) {
+                QVERIFY2(host->rect().contains(card->geometry()), qPrintable(QString("Card outside host at width %1").arg(width)));
+                for (auto *other : cards) if (other != card)
+                    QVERIFY(!other->geometry().intersects(card->geometry()));
+                for (auto *label : card->findChildren<QLabel *>()) {
+                    const QRect geometry(label->mapTo(card, QPoint()), label->size());
+                    QVERIFY(card->rect().contains(geometry));
+                    if (label->wordWrap()) QVERIFY(label->height() >= label->heightForWidth(label->width()));
+                }
+            }
+        }
+    }
+    void emptyAndSingleCard() {
+        QWidget host;
+        auto *layout = new WrappingGridLayout(&host);
+        QCOMPARE(layout->heightForWidth(400), 0);
+        Package package;
+        package.displayName = "Paint";
+        layout->addWidget(new ProgramCard(package));
+        host.resize(400, layout->heightForWidth(400));
+        host.show();
+        QTest::qWait(50);
+        QCOMPARE(layout->count(), 1);
+        QVERIFY(host.rect().contains(layout->itemAt(0)->geometry()));
+    }
+};
+QTEST_MAIN(HomeLayoutTest)
+#include "test_home_layout.moc"
