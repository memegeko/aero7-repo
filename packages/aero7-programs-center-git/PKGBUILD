pkgname=aero7-programs-center-git
pkgver=0.1.0.r12.g0405a2e
pkgrel=1
pkgdesc='Optional graphical software manager for Aero7 Linux (Beta)'
arch=('x86_64')
url='https://github.com/aero7-open-project/aero7-programs-center'
license=('MIT')
depends=('appstream' 'pacman' 'polkit' 'qt6-base')
makedepends=('cmake' 'git' 'ninja' 'pkgconf')
provides=('aero7-programs-center')
conflicts=('aero7-programs-center')
options=('!debug')
_commit=0405a2ef42c96d253a9436b3413fdccfe7c1cb09
source=("aero7-programs-center::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cmake -S aero7-programs-center -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 aero7-programs-center/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
