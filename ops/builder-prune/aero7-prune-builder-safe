#!/usr/bin/python3 -I
"""One no-argument, audited builder cleanup entry point for the admin account.

Install this file root:root, 0755. The retained prune script is also installed
root-owned, but runs as aero7build. This wrapper is the only sudoers allowance.
"""

from __future__ import annotations

import fcntl
import hashlib
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import time
from pathlib import Path


BUILDER_USER = "aero7build"
BUILDER_ROOT = Path("/srv/aero7-builder")
CURRENT_ID = BUILDER_ROOT / "current-build-id"
HELPER = Path("/usr/local/libexec/aero7/prune-builder.sh")
HELPER_SHA256 = "fcdf6671028473e16fbf59f2efe8bfa4037b7e2d33b955fe487096d7406e2b80"
RUNNER_UNIT = "actions.runner.memegeko-aero7-repo.aero7-builder.service"
LOCK = Path("/run/aero7-builder-prune.lock")
BUILD_ID = re.compile(r"[0-9]{8}T[0-9]{6}Z-([0-9a-f]{12}|local)\Z")
MIN_FREE_BYTES = 20 * 1024**3


class CleanupError(Exception):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise CleanupError(message)


def verify_directory(path: Path, owner: int) -> None:
    info = os.lstat(path)
    require(stat.S_ISDIR(info.st_mode), f"expected a real directory: {path}")
    require(info.st_uid == owner, f"unexpected directory owner: {path}")
    require(info.st_mode & 0o022 == 0, f"directory is writable by group or others: {path}")


def verify_helper() -> None:
    info = os.lstat(HELPER)
    require(stat.S_ISREG(info.st_mode), "installed prune helper is not a regular file")
    require(info.st_uid == 0 and info.st_gid == 0, "installed prune helper is not root-owned")
    require(info.st_mode & 0o022 == 0, "installed prune helper is writable by non-root")
    h = hashlib.sha256()
    with HELPER.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    require(h.hexdigest() == HELPER_SHA256, "installed prune helper checksum changed")


def read_current_id(uid: int) -> str:
    descriptor = os.open(CURRENT_ID, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        require(stat.S_ISREG(info.st_mode), "current build ID is not a regular file")
        require(info.st_uid == uid, "current build ID has an unexpected owner")
        require(info.st_mode & 0o022 == 0, "current build ID is writable by group or others")
        require(info.st_size <= 64, "current build ID is too large")
        value = os.read(descriptor, 65).decode("ascii").strip()
    finally:
        os.close(descriptor)
    require(BUILD_ID.fullmatch(value) is not None, f"invalid current build ID: {value!r}")
    return value


def builder_processes(uid: int) -> list[tuple[int, str]]:
    processes = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != uid:
                continue
            cmd = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace").strip()
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        processes.append((int(entry.name), cmd))
    return processes


def idle_runner_process(command: str) -> bool:
    return (
        command.startswith("/bin/bash /home/aero7build/actions-runner/runsvc.sh")
        or ("/bin/RunnerService.js" in command and "node" in command)
        or "Runner.Listener" in command
    )


def run(command: list[str], *, timeout: int = 120, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, timeout=timeout, env=env, cwd="/", check=False)


def main() -> int:
    require(len(sys.argv) == 1, "this command accepts no arguments")
    require(os.geteuid() == 0, "this command must be invoked through its narrow sudoers allowance")
    info = pwd.getpwnam(BUILDER_USER)
    uid = info.pw_uid
    require(uid != 0, "build account unexpectedly has root UID")

    # /run is tmpfs, so acquiring the lock also works when / is full.
    lock_fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        raise CleanupError("another guarded cleanup is already running") from error

    verify_directory(Path("/srv"), 0)
    for path in (BUILDER_ROOT, BUILDER_ROOT / "staging", BUILDER_ROOT / "sources"):
        verify_directory(path, uid)
    verify_helper()
    current = read_current_id(uid)

    unexpected = [(pid, command) for pid, command in builder_processes(uid)
                  if not idle_runner_process(command)]
    require(not unexpected, f"build account has an active process; cleanup refused: {unexpected}")

    was_active = run(["/usr/bin/systemctl", "is-active", "--quiet", RUNNER_UNIT]).returncode == 0
    runner_enabled = run(["/usr/bin/systemctl", "is-enabled", "--quiet", RUNNER_UNIT]).returncode == 0
    if was_active:
        stopped = run(["/usr/bin/systemctl", "stop", RUNNER_UNIT], timeout=45)
        require(stopped.returncode == 0, "could not stop the runner; cleanup refused")
    for _ in range(20):
        remaining = builder_processes(uid)
        if not remaining:
            break
        time.sleep(0.5)
    require(not remaining, f"build-account processes remain after runner stop: {remaining}")
    require(read_current_id(uid) == current, "current build ID changed while stopping the runner")

    # These are the same fixed cache-retention commands as prune-builder.sh.
    # A cache-trim error is reported, while the private staging cleanup still
    # gets a chance to recover the configured free-space floor.
    for command in (["/usr/bin/paccache", "-rk2"], ["/usr/bin/paccache", "-ruk0"]):
        result = run(command, timeout=120)
        if result.returncode:
            print(f"aero7-prune-builder-safe: cache trim failed: {command[-1]}", file=sys.stderr)

    environment = {
        "HOME": info.pw_dir,
        "PATH": "/usr/bin:/bin",
        "AERO7_BUILDER_ROOT": str(BUILDER_ROOT),
        "AERO7_KEEP_STAGING_BUILDS": "2",
        "AERO7_MIN_FREE_GIB": "20",
        "AERO7_TRIM_PACMAN_CACHE": "0",
    }
    result = run(
        ["/usr/bin/runuser", "-u", BUILDER_USER, "--", str(HELPER), "--current-build-id", current],
        timeout=600,
        env=environment,
    )
    free = shutil.disk_usage(BUILDER_ROOT).free
    print(f"aero7-prune-builder-safe: {free // 1024**3} GiB available after guarded cleanup")
    require(result.returncode == 0 and free >= MIN_FREE_BYTES,
            "guarded cleanup did not reach 20 GiB; runner remains stopped")

    if was_active or runner_enabled:
        started = run(["/usr/bin/systemctl", "start", RUNNER_UNIT], timeout=45)
        require(started.returncode == 0, "storage recovered, but runner restart failed")
        print("aero7-prune-builder-safe: runner service started; verify GitHub runner online status")
    else:
        print("aero7-prune-builder-safe: runner was inactive and disabled; it was left inactive")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (CleanupError, OSError, UnicodeError, subprocess.TimeoutExpired) as error:
        print(f"aero7-prune-builder-safe: {error}", file=sys.stderr)
        raise SystemExit(1)
